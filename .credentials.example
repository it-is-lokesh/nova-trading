# Copy this file to `.credentials`, fill real values, then run:
# python applications/security.py

# Get API_KEY from the AngelOne SmartAPI platform.
API_KEY = ""

# AngelOne client/user ID.
CLIENT_CODE = ""

# AngelOne login PIN.
CLIENT_PIN = ""

# Optional manual TOTP code. Usually leave this empty when TOTP_SECRET is set.
TOTP_CODE = ""

# TOTP secret from AngelOne SmartAPI 2FA setup.
TOTP_SECRET = ""

# SmartAPI state value used during login.
STATE_VARIABLE = "get_authorization"

# Optional. Leave empty initially; fetch/auth scripts refresh and store this encrypted.
JWT_TOKEN = ""

# Network metadata required by AngelOne SmartAPI.
CLIENT_LOCAL_IP = ""
CLIENT_PUBLIC_IP = ""
MAC_ADDRESS = ""
